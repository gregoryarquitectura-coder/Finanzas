# --- Base de datos Postgres (Supabase) ---
# Project Settings > Connect > Connection String
#   DATABASE_URL = "Transaction pooler" (puerto 6543)
#   DIRECT_URL   = "Session pooler" (puerto 5432) — la conexión "Directa" normal
#                   suele ser IPv6-only y no conecta desde redes comunes.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Acceso ---
FINANCE_PIN="1234"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Zona horaria ---
APP_TIMEZONE="America/Santiago"

# El escaneo de boletas (Movimientos → Escanear boleta) usa OCR gratis en el
# navegador (tesseract.js) — no necesita ninguna variable de entorno ni API key.
